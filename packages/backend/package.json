{
  "name": "@prompt64/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && find dist -name '*.test.*' -delete && mkdir -p dist/reference/data && cp -r src/reference/data/. dist/reference/data/",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.2",
    "@prompt64/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "nanoid": "^5.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
